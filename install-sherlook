#!/usr/bin/env bash
# ==============================================================================
#  Sherlook Installation & Deployment Engine
#  Version: 6.4.0
# ==============================================================================

set -euo pipefail

VERSION="6.4.0"
INSTALL_DIR="/usr/local/bin"
SHERLOOK_BIN="${INSTALL_DIR}/sherlook"
RAW_BASE_URL="https://raw.githubusercontent.com/SherlookHolmz/sherlook/main"

echo "=================================================================="
echo "          Installing Sherlook Tor Proxy Manager v${VERSION}       "
echo "=================================================================="

# Root Check
if [[ $EUID -ne 0 ]]; then
   echo "[!] This script must be run as root. Try: sudo $0"
   exit 1
fi

# Package Manager Detection & Dependency Installation
install_dependencies() {
    echo "[+] Checking system dependencies..."
    local deps=("tor" "curl" "jq" "nc" "flock")
    local missing=()

    for dep in "${deps[@]}"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            missing+=("$dep")
        fi
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        echo "[✓] All dependencies met."
        return 0
    fi

    echo "[+] Installing missing packages: ${missing[*]}..."

    if command -v apt-get >/dev/null 2>&1; then
        apt-get update -qq
        apt-get install -y -qq tor curl jq netcat-openbsd util-linux
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y -q tor curl jq nc util-linux
    elif command -v yum >/dev/null 2>&1; then
        yum install -y -q tor curl jq nc util-linux
    elif command -v pacman >/dev/null 2>&1; then
        pacman -Sy --noconfirm tor curl jq gnu-netcat util-linux
    else
        echo "[!] Unsupported package manager. Please install missing packages manually."
    fi
}

# Deploy Sherlook Binary
deploy_binary() {
    echo "[+] Fetching latest Sherlook binary (v${VERSION})..."
    local tmp_script="/tmp/sherlook_install.sh"

    if curl -s -f -L "${RAW_BASE_URL}/sherlook.sh" -o "$tmp_script"; then
        if bash -n "$tmp_script"; then
            mv -f "$tmp_script" "$SHERLOOK_BIN"
            chmod +x "$SHERLOOK_BIN"
            echo "[✓] Installed binary to ${SHERLOOK_BIN}"
        else
            echo "[!] Syntax check failed for downloaded binary. Installation aborted."
            rm -f "$tmp_script"
            exit 1
        fi
    else
        echo "[!] Failed to download sherlook.sh from repository."
        exit 1
    fi
}

# Setup Systemd Service (Optional Auto-Heal Daemon)
setup_systemd() {
    echo "[+] Setting up systemd service for Auto-Heal Daemon..."
    cat <<EOF > /etc/systemd/system/sherlook-daemon.service
[Unit]
Description=Sherlook Tor Auto-Heal Daemon
After=network.target

[Service]
Type=simple
ExecStart=${SHERLOOK_BIN} --daemon
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload || true
    systemctl enable sherlook-daemon.service || true
    echo "[✓] Systemd service 'sherlook-daemon' configured."
}

# Execution Flow
install_dependencies
deploy_binary
setup_systemd

echo "=================================================================="
echo " [✓] Sherlook v${VERSION} Installation Complete!"
echo " Run 'sherlook' in your terminal to start the management CLI."
echo "=================================================================="
