#!/usr/bin/env bash
# Sherlook Multi v6.2.5 installer
set -euo pipefail

VERSION="6.2.5"
TARGET="/usr/local/bin/sherlook"
CACHE_DIR="/root/.sherlook"
BASE_DIR="/etc/tor/sherlook_nodes"
DATA_DIR="/var/lib/tor/sherlook_nodes"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
LOCAL_ENGINE="$SELF_DIR/sherlook.sh"
RAW_ENGINE_URL="https://raw.githubusercontent.com/SherlookHolmz/multi/main/sherlook.sh"

[ "${EUID:-$(id -u)}" -eq 0 ] || { echo '[!] Run as root.'; exit 1; }

apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y tor tor-geoipdb curl jq openssl cron ca-certificates util-linux python3

systemctl stop tor 2>/dev/null || true
systemctl disable tor 2>/dev/null || true
mkdir -p "$CACHE_DIR" "$BASE_DIR" "$DATA_DIR"
chmod 700 "$CACHE_DIR" "$BASE_DIR"
chown -R debian-tor:debian-tor "$DATA_DIR" 2>/dev/null || true

TMP="$(mktemp /tmp/sherlook-install.XXXXXX.sh)"
cleanup() { rm -f "$TMP"; }
trap cleanup EXIT

if [ -f "$LOCAL_ENGINE" ]; then
    cp "$LOCAL_ENGINE" "$TMP"
else
    curl -4 -fsSL --retry 5 --retry-all-errors --connect-timeout 10 --max-time 120 -o "$TMP" "$RAW_ENGINE_URL"
fi

bash -n "$TMP"
install -m 755 "$TMP" "$TARGET"
install -m 755 "$TMP" "$CACHE_DIR/sherlook.sh"

# Existing panel token/config must remain private.
[ -f "$BASE_DIR/nexatis_panel.conf" ] && chmod 600 "$BASE_DIR/nexatis_panel.conf" || true
[ -f "$BASE_DIR/panel_node_map.json" ] && chmod 600 "$BASE_DIR/panel_node_map.json" || true

cat > /etc/systemd/system/sherlook-heal.service <<UNIT
[Unit]
Description=Sherlook v6.2.5 Continuous Tor Node Health and IP Auto-Heal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$TARGET --auto-heal-daemon
Restart=always
RestartSec=3
User=root
MemoryMax=256M
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/cron.d/sherlook_watchdog <<CRON
*/15 * * * * root systemctl is-active --quiet sherlook-heal.service || systemctl restart sherlook-heal.service
CRON
chmod 644 /etc/cron.d/sherlook_watchdog

systemctl daemon-reload
systemctl enable sherlook-heal.service
systemctl restart cron 2>/dev/null || true

# Initial fetch/patch: this also guarantees the new logo/version is active immediately.
SHERLOOK_FORCE_UPDATE=1 "$TARGET" --refresh
systemctl restart sherlook-heal.service

echo "[+] Sherlook v$VERSION installed successfully."
echo "[+] Engine: $TARGET"
echo "[+] Service: sherlook-heal.service"
echo "[+] New dynamic logo/version: V $VERSION"
