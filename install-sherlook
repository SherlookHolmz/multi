#!/usr/bin/env bash
# Sherlook 6.2.2 resilient installer
set -euo pipefail

RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; CYAN='\033[1;36m'; NC='\033[0m'
RAW_WRAPPER_URL="https://raw.githubusercontent.com/SherlookHolmz/multi/main/sherlook.sh"
INSTALL_PATH="/usr/local/bin/sherlook"
STATE_DIR="/var/lib/tor/sherlook_nodes"
CACHE="$STATE_DIR/.installer-wrapper.sh"
TMP="$(mktemp /tmp/sherlook-6.2.2.XXXXXX.sh)"
trap 'rm -f "$TMP"' EXIT

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
  echo -e "${RED}[!] Please run as root.${NC}" >&2
  exit 1
fi

mkdir -p "$STATE_DIR"

fetch_wrapper() {
  curl -4 -fL \
    --retry 10 --retry-all-errors --retry-delay 2 \
    --connect-timeout 8 --max-time 120 -sS \
    -o "$TMP" "$RAW_WRAPPER_URL"
}

if ! fetch_wrapper; then
  if [ -s "$CACHE" ] && head -n1 "$CACHE" | grep -q '^#!' && bash -n "$CACHE"; then
    echo -e "${YELLOW}[!] GitHub temporarily unavailable; using the last known-good installer wrapper.${NC}"
    cp -f "$CACHE" "$TMP"
  else
    echo -e "${RED}[!] Could not download Sherlook and no cached installer is available.${NC}" >&2
    exit 1
  fi
fi

head -n1 "$TMP" | grep -q '^#!'
bash -n "$TMP"
install -m 755 "$TMP" "$INSTALL_PATH"
install -m 755 "$TMP" "$CACHE"
install -d -m 755 /root/.sherlook
install -m 755 "$TMP" /root/.sherlook/sherlook.sh

# The wrapper itself is responsible for fetching/caching the pinned base engine.
# A failed network request therefore does not replace a working engine.
"$INSTALL_PATH" --install

if systemctl list-unit-files 2>/dev/null | grep -q '^sherlook-heal\.service'; then
  systemctl daemon-reload 2>/dev/null || true
  systemctl restart sherlook-heal.service 2>/dev/null || true
fi

echo -e "${GREEN}[+] Sherlook 6.2.2 installed.${NC}"
echo -e "${GREEN}[+] Tor-Exit-only country list, verified-IP auto-heal, persistent state, and network-loss resilience are enabled.${NC}"
