#!/usr/bin/env bash
set -euo pipefail
VERSION='6.2.6'
RAW_ENGINE_URL='https://raw.githubusercontent.com/SherlookHolmz/multi/main/sherlook.sh'
TARGET='/usr/local/bin/sherlook'
TMP=$(mktemp /tmp/sherlook-engine.XXXXXX.sh)
trap 'rm -f "$TMP"' EXIT
[ "${EUID:-$(id -u)}" -eq 0 ] || { echo '[!] Run as root.' >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
if command -v curl >/dev/null 2>&1; then
  curl -4 -fsSL --retry 3 --retry-all-errors --connect-timeout 8 --max-time 120 -o "$TMP" "$RAW_ENGINE_URL"
elif command -v wget >/dev/null 2>&1; then
  wget -qO "$TMP" "$RAW_ENGINE_URL"
else
  echo '[!] curl or wget is required.' >&2; exit 1
fi
bash -n "$TMP"
grep -q "VERSION='${VERSION}'" "$TMP" || { echo "[!] Refusing unexpected Sherlook version." >&2; exit 1; }
install -m 755 "$TMP" "$TARGET"
SHERLOOK_USE_INSTALLED_SOURCE=1 exec "$TARGET" --install
