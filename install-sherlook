#!/usr/bin/env bash
# Sherlook Engine Installer Script

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
NC='\033[0m'

RAW_BASE="https://raw.githubusercontent.com/SherlookHolmz/multi/main"
RAW_ENGINE_URL="$RAW_BASE/sherlook.sh"
INSTALL_PATH="/usr/local/bin/sherlook"
BASE_DIR="/etc/tor/sherlook_nodes"
DATA_DIR="/var/lib/tor/sherlook_nodes"

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}[!] Error: Please run as root (sudo).${NC}"
        exit 1
    fi
}

draw_header() {
    clear
    echo -e "${MAGENTA} ╔════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA} ║${CYAN}   ███████╗██╗  ██╗███████╗██████╗ ██╗      ██████╗  ██████╗ ██╗  ██╗${MAGENTA} ║${NC}"
    echo -e "${MAGENTA} ║${CYAN}   ██╔════╝██║  ██║██╔════╝██╔══██╗██║     ██╔═══██╗██╔═══██╗██║ ██╔╝${MAGENTA} ║${NC}"
    echo -e "${MAGENTA} ║${CYAN}   ███████╗███████║█████╗  ██████╔╝██║     ██║   ██║██║   ██║█████╔╝ ${MAGENTA} ║${NC}"
    echo -e "${MAGENTA} ║${CYAN}   ╚════██║██╔══██║██╔══╝  ██╔══██╗██║     ██║   ██║██║   ██║██╔═██╗ ${MAGENTA} ║${NC}"
    echo -e "${MAGENTA} ║${CYAN}   ███████║██║  ██║███████╗██║  ██║███████╗╚██████╔╝╚██████╔╝██║  ██╗${MAGENTA} ║${NC}"
    echo -e "${MAGENTA} ║${CYAN}   ╚══════╝╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚══════╝ ╚═════╝  ╚═════╝ ╚═╝  ╚═╝${MAGENTA} ║${NC}"
    echo -e "${MAGENTA} ║${YELLOW}                I N S T A L L E R   S C R I P T                  ${MAGENTA}║${NC}"
    echo -e "${MAGENTA} ╚════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

main() {
    check_root
    draw_header

    echo -e "${YELLOW}[*] Updating package index...${NC}"
    apt-get update -qq

    echo -e "${YELLOW}[*] Installing dependencies (tor, jq, curl, etc.)...${NC}"
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        tor tor-geoipdb curl jq nano openssl unzip zip cron ca-certificates util-linux

    systemctl stop tor 2>/dev/null || true
    systemctl disable tor 2>/dev/null || true

    mkdir -p "$BASE_DIR" "$DATA_DIR" /root/.sherlook
    chown -R debian-tor:debian-tor "$DATA_DIR" 2>/dev/null || true

    local tmp_script
    tmp_script=$(mktemp /tmp/sherlook_install.XXXXXX) || exit 1

    if [ -f "./sherlook.sh" ]; then
        echo -e "${GREEN}[+] Local sherlook.sh found. Using local file...${NC}"
        cp "./sherlook.sh" "$tmp_script"
    else
        echo -e "${CYAN}[*] Downloading latest Sherlook Engine from Github...${NC}"
        if ! curl -4 -fL --retry 3 --connect-timeout 10 --max-time 60 -o "$tmp_script" "$RAW_ENGINE_URL"; then
            echo -e "${RED}[!] Failed to download engine core script.${NC}"
            rm -f "$tmp_script"
            exit 1
        fi
    fi

    if ! bash -n "$tmp_script"; then
        echo -e "${RED}[!] Engine script syntax validation failed.${NC}"
        rm -f "$tmp_script"
        exit 1
    fi

    install -m 755 "$tmp_script" "$INSTALL_PATH"
    install -m 755 "$tmp_script" /root/.sherlook/sherlook.sh
    rm -f "$tmp_script"

    cat > /etc/systemd/system/sherlook-heal.service <<EOF
[Unit]
Description=Sherlook Continuous Tor Node Health and IP Auto-Heal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$INSTALL_PATH --auto-heal-daemon
Restart=always
RestartSec=2
User=root
MemoryMax=256M
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable --now sherlook-heal.service

    echo "*/15 * * * * root systemctl is-active --quiet sherlook-heal.service || systemctl restart sherlook-heal.service" > /etc/cron.d/sherlook_watchdog
    chmod 644 /etc/cron.d/sherlook_watchdog
    systemctl restart cron 2>/dev/null || true

    echo -e "\n${GREEN}[+] Installation finished successfully!${NC}"
    echo -e "${CYAN}[*] You can now start the manager anytime by typing:${NC} ${WHITE}sherlook${NC}\n"
}

main "$@"
