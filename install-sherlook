#!/usr/bin/env bash
set -euo pipefail

REPO_BASE="https://raw.githubusercontent.com/SherlookHolmz/multi/main"
ENGINE_URL="$REPO_BASE/sherlook.sh"
INSTALLER_URL="$REPO_BASE/install.sh"

INSTALL_DIR="/root/.sherlook"
INSTALL_PATH="/usr/local/bin/sherlook"
BASE_DIR="/etc/tor/sherlook_nodes"
DATA_DIR="/var/lib/tor/sherlook_nodes"
EXPECTED_VERSION="6.1.0"

say(){ printf '%s\n' "$*"; }
fail(){ say "[!] $*"; exit 1; }

[ "${EUID:-$(id -u)}" -eq 0 ] || fail "Please run as root."

apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y \
    tor tor-geoipdb curl jq ca-certificates util-linux cron

mkdir -p "$INSTALL_DIR" "$BASE_DIR" "$DATA_DIR"

# Preserve existing node/state data before installing anything.
backup="$(mktemp -d /tmp/sherlook-state.XXXXXX)"
trap 'rm -rf "$backup" "$engine" "$installer"' EXIT
cp -a "$BASE_DIR/." "$backup/base/" 2>/dev/null || true
cp -a "$DATA_DIR/." "$backup/data/" 2>/dev/null || true

engine="$(mktemp /tmp/sherlook-engine.XXXXXX)"
installer="$(mktemp /tmp/sherlook-installer.XXXXXX)"

curl -4 -fL --retry 5 --retry-delay 1 \
    --connect-timeout 10 --max-time 90 \
    -o "$engine" "$ENGINE_URL" || fail "Engine download failed."

bash -n "$engine" || fail "Engine syntax validation failed."
grep -q "^SHERLOOK_VERSION=\"$EXPECTED_VERSION\"$" "$engine" \
    || fail "Remote engine is not v$EXPECTED_VERSION."

# Never install a stale v6.0 engine.
if grep -qE 'v6\.0|6\.0\.0|V 6 \. 0' "$engine"; then
    fail "Downloaded engine still contains v6.0 markers."
fi

if curl -4 -fL --retry 3 --connect-timeout 10 --max-time 60 \
    -o "$installer" "$INSTALLER_URL"; then
    bash -n "$installer" || fail "Installer syntax validation failed."
else
    rm -f "$installer"
fi

install -m 755 "$engine" "$INSTALL_DIR/sherlook.sh"
install -m 755 "$engine" "$INSTALL_PATH"

if [ -s "$installer" ]; then
    install -m 755 "$installer" "$INSTALL_DIR/install.sh"
    install -m 755 "$installer" /usr/local/bin/sherlook-install
fi

# Restore state only if the target directories became empty.
if [ -d "$backup/base" ] && [ -z "$(find "$BASE_DIR" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    cp -a "$backup/base/." "$BASE_DIR/" 2>/dev/null || true
fi
if [ -d "$backup/data" ] && [ -z "$(find "$DATA_DIR" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    cp -a "$backup/data/." "$DATA_DIR/" 2>/dev/null || true
fi
chown -R debian-tor:debian-tor "$DATA_DIR" 2>/dev/null || true

cat > /etc/systemd/system/sherlook-heal.service <<EOF
[Unit]
Description=Sherlook Continuous Tor Node Health and IP Auto-Heal
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=$INSTALL_PATH --auto-heal-daemon
Restart=always
RestartSec=2
User=root
MemoryMax=256M

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now sherlook-heal.service

cat > /etc/cron.d/sherlook_watchdog <<EOF
*/5 * * * * root systemctl is-active --quiet sherlook-heal.service || systemctl restart sherlook-heal.service
EOF
chmod 644 /etc/cron.d/sherlook_watchdog
systemctl restart cron 2>/dev/null || true

say "[+] Sherlook v$EXPECTED_VERSION installed."
say "[+] Engine: $(grep -m1 '^SHERLOOK_VERSION=' "$INSTALL_PATH")"
say "[+] Auto-Heal: $(systemctl is-active sherlook-heal.service 2>/dev/null || true)"
