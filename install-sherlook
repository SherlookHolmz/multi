#!/usr/bin/env bash
# Sherlook Engine Installer v6.2.3
set -euo pipefail
RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; CYAN='\033[1;36m'; WHITE='\033[1;37m'; NC='\033[0m'
RAW_BASE="https://raw.githubusercontent.com/SherlookHolmz/multi/main"
RAW_ENGINE_URL="$RAW_BASE/sherlook.sh"
INSTALL_PATH="/usr/local/bin/sherlook"
BASE_DIR="/etc/tor/sherlook_nodes"
DATA_DIR="/var/lib/tor/sherlook_nodes"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_ENGINE="$SCRIPT_DIR/sherlook-v6.2.3.sh"

check_root() { [ "$EUID" -eq 0 ] || { echo -e "${RED}[!] Run as root (sudo).${NC}"; exit 1; }; }

main() {
  check_root
  echo -e "${CYAN}[*] Installing Sherlook v6.2.3...${NC}"
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y tor tor-geoipdb curl jq openssl cron ca-certificates util-linux
  systemctl stop tor 2>/dev/null || true
  systemctl disable tor 2>/dev/null || true
  mkdir -p "$BASE_DIR" "$DATA_DIR" /root/.sherlook
  chown -R debian-tor:debian-tor "$DATA_DIR" 2>/dev/null || true
  local tmp
  tmp=$(mktemp /tmp/sherlook_install.XXXXXX)
  if [ -f "$LOCAL_ENGINE" ]; then
    echo -e "${GREEN}[+] Using local v6.2.3 engine.${NC}"
    cp "$LOCAL_ENGINE" "$tmp"
  elif [ -f "$SCRIPT_DIR/sherlook.sh" ]; then
    echo -e "${GREEN}[+] Using local sherlook.sh.${NC}"
    cp "$SCRIPT_DIR/sherlook.sh" "$tmp"
  else
    echo -e "${CYAN}[*] Downloading engine from GitHub...${NC}"
    curl -4 -fL --retry 5 --retry-delay 1 --connect-timeout 10 --max-time 90 -o "$tmp" "$RAW_ENGINE_URL"
  fi
  bash -n "$tmp"
  install -m 755 "$tmp" "$INSTALL_PATH"
  install -m 755 "$tmp" /root/.sherlook/sherlook.sh
  rm -f "$tmp"
  cat > /etc/systemd/system/sherlook-heal.service <<UNIT
[Unit]
Description=Sherlook Continuous Tor Node Health and IP Auto-Heal
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=$INSTALL_PATH --auto-heal-daemon
Restart=always
RestartSec=2
User=root
MemoryMax=256M
NoNewPrivileges=false
[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable --now sherlook-heal.service
  printf '%s\n' '*/15 * * * * root systemctl is-active --quiet sherlook-heal.service || systemctl restart sherlook-heal.service' > /etc/cron.d/sherlook_watchdog
  chmod 644 /etc/cron.d/sherlook_watchdog
  systemctl restart cron 2>/dev/null || true
  echo -e "${GREEN}[+] Sherlook v6.2.3 installed successfully.${NC}"
}
main "$@"
