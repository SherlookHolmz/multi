#!/usr/bin/env bash
# Sherlook Automate Engine (Nexatis Edition) - Auto Installer

RED='\033[1;31m'
GREEN='\033[1;32m'
CYAN='\033[1;36m'
NC='\033[0m'

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}[!] Error: Please run as root (sudo).${NC}"
    exit 1
fi

echo -e "${CYAN}[*] Fetching the latest Sherlook Engine...${NC}"
RAW_URL="https://raw.githubusercontent.com/SherlookHolmz/multi/main/sherlook.sh"

# Download the script to a temporary location
curl -4 -fL --connect-timeout 10 --max-time 30 -o /tmp/sherlook.sh "$RAW_URL"

if [ $? -ne 0 ]; then
    echo -e "${RED}[!] Failed to download the engine from GitHub.${NC}"
    exit 1
fi

chmod +x /tmp/sherlook.sh
echo -e "${GREEN}[+] Download successful. Starting automated installation...${NC}"

# Execute the engine with the silent install flag
/tmp/sherlook.sh --install

# Clean up
rm -f /tmp/sherlook.sh
