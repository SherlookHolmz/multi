#!/usr/bin/env bash
# Sherlook Automate Engine Installer v7.1.0
# Safe installer/updater for sherlook.sh
set -euo pipefail

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
NC='\033[0m'

VERSION="7.1.0"
INSTALL_PATH="/usr/local/bin/sherlook"
BASE_DIR="/etc/tor/sherlook_nodes"
DATA_DIR="/var/lib/tor/sherlook_nodes"

SHERLOOK_REPO="${SHERLOOK_REPO:-SherlookHolmz/multi}"
SHERLOOK_BRANCH="${SHERLOOK_BRANCH:-main}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Preferred local names. Keeping sherlook.sh as a fallback makes the installer
# compatible with the repository's existing layout.
LOCAL_ENGINE_1="$SCRIPT_DIR/sherlook-${VERSION}.sh"
LOCAL_ENGINE_2="$SCRIPT_DIR/sherlook.sh"

check_root() {
    [ "$EUID" -eq 0 ] || {
        echo -e "${RED}[!] این نصب‌کننده باید با root اجرا شود.${NC}"
        exit 1
    }
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || {
        echo -e "${RED}[!] ابزار موردنیاز پیدا نشد: $1${NC}"
        exit 1
    }
}

install_packages() {
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y \
        tor tor-geoipdb obfs4proxy curl jq openssl cron ca-certificates \
        util-linux psmisc
}

fetch_remote_engine() {
    need_cmd curl
    need_cmd jq

    local api="https://api.github.com/repos/$SHERLOOK_REPO/commits/$SHERLOOK_BRANCH"
    local raw="https://raw.githubusercontent.com/$SHERLOOK_REPO"
    local commit tmp remote

    commit=$(curl -4 -fsSL --connect-timeout 10 --max-time 30 \
        -H 'Accept: application/vnd.github+json' "$api" |
        jq -r '.sha // empty')

    [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || {
        echo -e "${RED}[!] دریافت commit شاخه $SHERLOOK_BRANCH ناموفق بود.${NC}"
        exit 1
    }

    tmp=$(mktemp /tmp/sherlook-engine.XXXXXX)
    remote="$raw/$commit/sherlook.sh"

    if ! curl -4 -fsSL --connect-timeout 10 --max-time 120 \
        -o "$tmp" "$remote"; then
        echo -e "${RED}[!] دانلود engine از $remote ناموفق بود.${NC}"
        rm -f "$tmp"
        exit 1
    fi

    bash -n "$tmp"
    local version
    version=$(grep -m1 '^SHERLOOK_VERSION=' "$tmp" | sed 's/^SHERLOOK_VERSION="//; s/"$//')

    if [ "$version" != "$VERSION" ]; then
        echo -e "${RED}[!] نسخهٔ remote برابر $VERSION نیست؛ نسخهٔ دریافت‌شده: ${version:-نامشخص}${NC}"
        echo -e "${YELLOW}[i] برای نصب نسخهٔ محلی، فایل‌های installer و sherlook-${VERSION}.sh را کنار هم قرار بده.${NC}"
        rm -f "$tmp"
        exit 1
    fi

    printf '%s\n' "$tmp"
}

write_unit() {
    cat > /etc/systemd/system/sherlook-heal.service <<UNIT
[Unit]
Description=Sherlook Continuous Tor Node Health and IP Auto-Heal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$INSTALL_PATH --auto-heal-daemon
Restart=always
RestartSec=2
User=root
MemoryMax=2G
CPUQuota=60%
CPUWeight=25
IOWeight=25
TasksMax=256
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
UNIT

    systemctl daemon-reload
}

install_engine_file() {
    local engine="$1"
    local old_version backup staging

    bash -n "$engine"
    grep -q '^SHERLOOK_VERSION="7\.1\.0"$' "$engine" || {
        echo -e "${RED}[!] نسخهٔ engine باید 7.1.0 باشد.${NC}"
        return 1
    }

    mkdir -p "$BASE_DIR" "$DATA_DIR" /root/.sherlook "$BASE_DIR/panel_tombstones"
    if id debian-tor >/dev/null 2>&1; then
        chown -R debian-tor:debian-tor "$DATA_DIR" 2>/dev/null || true
    fi

    backup=""
    if [ -f "$INSTALL_PATH" ]; then
        old_version=$("$INSTALL_PATH" --version 2>/dev/null || echo "unknown")
        backup="$BASE_DIR/sherlook.sh.bak.$(date +%Y%m%d_%H%M%S)"
        cp -a "$INSTALL_PATH" "$backup"
        echo -e "${CYAN}[i] نسخهٔ فعلی: $old_version${NC}"
        echo -e "${CYAN}[i] پشتیبان: $backup${NC}"
    fi

    staging="$INSTALL_PATH.new.$$"
    install -m 755 "$engine" "$staging"

    # Atomic replacement: the old executable remains untouched until the new
    # file is fully copied and validated.
    mv -f "$staging" "$INSTALL_PATH"
    install -m 755 "$engine" /root/.sherlook/sherlook.sh

    systemctl disable --now tor 2>/dev/null || true
    write_unit
    systemctl enable sherlook-heal.service

    if ! systemctl restart sherlook-heal.service; then
        echo -e "${RED}[!] اجرای سرویس جدید شکست خورد.${NC}"
        if [ -n "$backup" ] && [ -f "$backup" ]; then
            cp -a "$backup" "$INSTALL_PATH"
            systemctl daemon-reload
            systemctl restart sherlook-heal.service 2>/dev/null || true
            echo -e "${YELLOW}[!] نسخهٔ قبلی بازیابی شد.${NC}"
        fi
        return 1
    fi

    local installed
    installed=$("$INSTALL_PATH" --version 2>/dev/null || true)
    if [ "$installed" != "$VERSION" ]; then
        echo -e "${RED}[!] بررسی نسخه بعد از نصب شکست خورد: $installed${NC}"
        if [ -n "$backup" ] && [ -f "$backup" ]; then
            cp -a "$backup" "$INSTALL_PATH"
            systemctl daemon-reload
            systemctl restart sherlook-heal.service 2>/dev/null || true
            echo -e "${YELLOW}[!] نسخهٔ قبلی بازیابی شد.${NC}"
        fi
        return 1
    fi

    cat > /etc/cron.d/sherlook_watchdog <<CRON
*/15 * * * * root systemctl is-active --quiet sherlook-heal.service || systemctl restart sherlook-heal.service
CRON
    chmod 644 /etc/cron.d/sherlook_watchdog
    systemctl restart cron 2>/dev/null || true

    echo -e "${GREEN}[+] Sherlook v$VERSION با موفقیت نصب/به‌روزرسانی شد.${NC}"
    echo -e "${GREEN}[+] داده‌ها و تنظیمات نودهای قبلی حفظ شدند.${NC}"
    echo -e "${GREEN}[+] پایش خودکار سلامت فعال است.${NC}"
}

main() {
    check_root

    # Bootstrap first. Do not require jq/curl before apt can install them.
    need_cmd apt-get
    need_cmd systemctl
    install_packages

    need_cmd curl
    need_cmd jq
    need_cmd bash
    need_cmd install
    need_cmd flock
    need_cmd timeout
    need_cmd pgrep
    need_cmd pkill

    local engine=""
    if [ -f "$LOCAL_ENGINE_1" ]; then
        engine="$LOCAL_ENGINE_1"
        echo -e "${CYAN}[*] استفاده از engine محلی: $engine${NC}"
    elif [ -f "$LOCAL_ENGINE_2" ]; then
        engine="$LOCAL_ENGINE_2"
        echo -e "${CYAN}[*] استفاده از engine محلی: $engine${NC}"
    else
        echo -e "${YELLOW}[!] engine محلی پیدا نشد؛ دریافت نسخهٔ $VERSION از GitHub...${NC}"
        engine=$(fetch_remote_engine)
    fi

    install_engine_file "$engine"
}

main "$@"
