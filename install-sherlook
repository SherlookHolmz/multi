#!/usr/bin/env bash
# Sherlook installer — fetches sherlook.sh (if not already local) and runs
# its built-in installer (apt deps, systemd auto-heal service, etc).
set -euo pipefail

RAW_URL="https://raw.githubusercontent.com/SherlookHolmz/multi/main/sherlook.sh"
INSTALL_PATH="/usr/local/bin/sherlook"

if [ "$EUID" -ne 0 ]; then
    echo "[!] Please run as root (sudo bash install.sh)" >&2
    exit 1
fi

SRC=""
if [ -f "$(dirname "$0")/sherlook.sh" ]; then
    SRC="$(dirname "$0")/sherlook.sh"
    echo "[*] Using local sherlook.sh next to this installer..."
else
    echo "[*] No local sherlook.sh found next to this installer — downloading from GitHub..."
    TMP=$(mktemp /tmp/sherlook_dl.XXXXXX)
    if ! curl -4 -fL --retry 5 --retry-delay 1 --connect-timeout 10 --max-time 60 -o "$TMP" "$RAW_URL"; then
        echo "[!] Download failed and no local sherlook.sh is present. Aborting." >&2
        rm -f "$TMP"
        exit 1
    fi
    SRC="$TMP"
fi

head -n1 "$SRC" | grep -q '^#!' || { echo "[!] Downloaded file doesn't look like a shell script. Aborting." >&2; exit 1; }
bash -n "$SRC" || { echo "[!] sherlook.sh failed a syntax check. Aborting." >&2; exit 1; }

install -m 755 "$SRC" "$INSTALL_PATH"
echo "[+] Installed engine to $INSTALL_PATH"
echo "[*] Running built-in installer (apt packages + systemd auto-heal service)..."
"$INSTALL_PATH" --install

echo ""
echo "[+] Done. Run 'sherlook' any time to open the menu."
