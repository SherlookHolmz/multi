#!/bin/bash
set -e

REPO="https://raw.githubusercontent.com/SherlookHolmz/multi/main"
INSTALL_DIR="/root/.sherlook"

echo "[+] Installing Sherlook Multi..."
mkdir -p "$INSTALL_DIR"

echo "[+] Downloading sherlook.sh..."
curl -fL --retry 3 --connect-timeout 15 \
  -o "$INSTALL_DIR/sherlook.sh" \
  "$REPO/sherlook.sh"

chmod +x "$INSTALL_DIR/sherlook.sh"

echo "[+] Creating sherlook command..."

cat > /usr/local/bin/sherlook <<EOF
#!/bin/bash
exec "$INSTALL_DIR/sherlook.sh" "\$@"
EOF

chmod +x /usr/local/bin/sherlook

echo
echo "[+] Sherlook Multi installed successfully."
echo
echo "Run:"
echo "  sherlook"
echo
